{
  "name": "noteweld",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "test": "node --test tests/unit/*.test.mjs tests/ui/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "test:database": "node scripts/isolated.mjs database && node --test tests/database/migration.test.mjs tests/database/backup.test.mjs",
    "test:browser": "node scripts/isolated.mjs browser"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@replit/codemirror-vim": "6.4.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@next/env": "16.3.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
