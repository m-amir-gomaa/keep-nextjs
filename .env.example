# New development database only. Never commit credentials.
# Hosted PostgreSQL should verify the server certificate; local loopback does not use TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
AUTH_SECRET=replace-with-a-cryptographically-random-secret
AUTH_URL=http://localhost:3000
# Cloud backups additionally use an independent Fernet BACKUP_KEY in a provider secret.
